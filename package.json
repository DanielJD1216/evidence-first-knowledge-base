{
  "name": "@doomade/evidence-first-source-wire-adapter",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Publication-safe synthetic KnowledgeProvider v1 adapter for cross-repository Source-Wire conformance.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "dist/src/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "pack:inspect": "npm pack --dry-run --json"
  },
  "dependencies": {
    "@source-wire/contracts": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
}
